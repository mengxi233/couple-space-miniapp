# Application
APP_ENV=production
SECRET_KEY=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=https://example.com
CORS_ALLOWED_ORIGINS=https://example.com

# MySQL (keep MYSQL_PASSWORD and DATABASE_URI consistent)
MYSQL_DATABASE=couple_space
MYSQL_USER=couple
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-root-password
DATABASE_URI=mysql+pymysql://couple:replace-me@mysql:3306/couple_space

# WeChat Mini Program server credentials (server-side only)
WX_APPID=your-wechat-appid
WX_APPSECRET=your-wechat-appsecret
WX_ANNIVERSARY_TEMPLATE_ID=
WX_CALENDAR_TEMPLATE_ID=

# Pair activation. Use two different 16-character lowercase hexadecimal values.
COUPLE_OWNER_INVITE_CODE=0123456789abcdef
COUPLE_MEMBER_INVITE_CODE=fedcba9876543210
COUPLE_DEFAULT_NAME=我们的空间
COUPLE_DEFAULT_START_DATE=2025-01-01
COUPLE_DEV_LOGIN=false

# Optional SMTP notifications
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=ssl
SMTP_ALLOW_INSECURE=false

# Persistent storage inside the container
COUPLE_UPLOAD_DIR=/app/data/uploads
COUPLE_MEDIA_DIR=/app/data/media
LIGHTBOARD_DB=/app/data/runtime/lightboard_rooms.sqlite3
COUPLE_WHEEL_DB=/app/data/runtime/couple_wheel_rooms.sqlite3
