page{background:#fff7f8;color:#493c40}.soundboard-page{min-height:100vh;padding:0 30rpx 70rpx;box-sizing:border-box;background:linear-gradient(180deg,#fff8f9 0%,#fff3f6 100%)}
.theme-switch{display:flex;margin:4rpx 6rpx 34rpx;padding:7rpx;border-radius:42rpx;background:#fff;box-shadow:0 10rpx 28rpx #9c667612}.theme-option{display:flex;flex:1;align-items:center;justify-content:center;gap:10rpx;height:70rpx;border-radius:36rpx;color:#a28c92;font-size:24rpx;transition:all .2s}.theme-option.active{background:#f7e4eb;color:#694f59;font-weight:600;box-shadow:0 5rpx 14rpx #8e5d7317}.theme-dot{width:18rpx;height:18rpx;border-radius:50%}.male-dot{background:#76b6da}.female-dot{background:#e189aa}
.toy-wrap{position:relative;width:100%;margin:0;padding-left:54rpx;box-sizing:border-box}.keyring{position:absolute;left:-5rpx;top:50%;z-index:0;display:flex;align-items:center;transform:translateY(-50%)}.ring-large{width:120rpx;height:120rpx;border:12rpx solid #9d805b;border-radius:50%;box-sizing:border-box;box-shadow:inset 0 2rpx 3rpx #fff8}.ring-link{width:45rpx;height:25rpx;margin-left:-12rpx;border:10rpx solid #ad8c63;border-radius:18rpx;background:#f7e4eb;box-sizing:border-box}
.toy-shell{position:relative;z-index:1;min-height:410rpx;padding:28rpx 42rpx 24rpx;border:9rpx solid #e882aa;border-radius:48% / 38%;box-sizing:border-box;background:linear-gradient(160deg,#ffb7d0 0%,#f18ab1 56%,#de749b 100%);box-shadow:0 22rpx 38rpx #a851712e,inset 0 9rpx 9rpx #fff7,inset 0 -10rpx 13rpx #a8486b3b;overflow:hidden}.shell-shine{position:absolute;left:13%;right:13%;top:10rpx;height:16rpx;border-radius:50%;background:#fff7;filter:blur(4rpx)}
.button-row{position:relative;z-index:3;display:flex;align-items:center;justify-content:space-around;width:100%;padding:0 40rpx;box-sizing:border-box;transform:translateY(24rpx)}.bottom-row{margin-top:-10rpx}.sound-key{display:block;flex:0 0 70rpx;width:70rpx;height:50rpx;border:5rpx solid #674c57;border-radius:50%;box-sizing:border-box;background:linear-gradient(150deg,#ffdbea,#eaa1bd);box-shadow:inset 0 5rpx 7rpx #fff,0 5rpx 7rpx #8b385c55;transition:transform .12s,box-shadow .12s}.sound-key-pressed,.sound-key.active{transform:translateY(5rpx) scale(.96);box-shadow:inset 0 6rpx 9rpx #a54c704d,0 1rpx 3rpx #7e31504d}.sound-key.active{background:linear-gradient(150deg,#fff0f7,#f4b0ca);border-color:#fff}
.hero-stage{position:relative;z-index:2;display:flex;align-items:center;justify-content:center;height:190rpx;margin:-2rpx 0}.hero-image{position:absolute;bottom:0;width:142rpx;height:178rpx;filter:drop-shadow(0 5rpx 3rpx #8241584d)}.hero-left{left:-8rpx}.hero-right{right:-8rpx}.hero-copy{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;width:250rpx;text-align:center;text-shadow:0 3rpx 0 #fff,2rpx 0 0 #fff,-2rpx 0 0 #fff}.hero-small{color:#9c5148;font-size:34rpx;font-weight:800;line-height:1}.hero-title{margin-top:5rpx;color:#bf466e;font-size:42rpx;font-weight:900;line-height:1.12}.hero-badge{margin-top:10rpx;padding:5rpx 14rpx;border-radius:18rpx;background:#fff9;color:#97566b;font-size:17rpx;font-weight:700;letter-spacing:1rpx;text-shadow:none}
.player-card{margin:34rpx 7rpx 0;padding:28rpx 28rpx 24rpx;border:1rpx solid #efdde2;border-radius:30rpx;background:#fff;box-shadow:0 14rpx 34rpx #9b657214}.track-info{display:flex;align-items:center;gap:20rpx}.album-dot{display:flex;align-items:center;justify-content:center;width:74rpx;height:74rpx;border-radius:50%;background:repeating-radial-gradient(circle,#563d45 0 5rpx,#37292e 6rpx 9rpx);box-shadow:0 5rpx 14rpx #4b30343b}.album-hole{width:20rpx;height:20rpx;border:7rpx solid #d982a2;border-radius:50%;background:#fff}.spinning{animation:spin 5s linear infinite}.track-copy{flex:1;min-width:0}.track-title{display:block;color:#4e3d42;font-size:29rpx;font-weight:700}.track-state{display:block;margin-top:7rpx;color:#af959d;font-size:21rpx}.progress-slider{margin:24rpx -8rpx 0}.time-row{display:flex;justify-content:space-between;margin-top:-7rpx;color:#b7a0a7;font-size:18rpx}.player-controls{display:flex;align-items:center;justify-content:center;gap:58rpx;margin-top:13rpx}.control-button{display:flex;flex:none;align-items:center;justify-content:center;border-radius:50%;box-sizing:border-box;background:transparent;color:#6c515a;transition:transform .12s,opacity .12s}.control-pressed{transform:scale(.92);opacity:.78}.side-control{width:64rpx;height:64rpx;font-size:31rpx}.main-control{width:88rpx;height:88rpx;background:#d982a2;color:#fff;box-shadow:0 9rpx 20rpx #b2567852}.play-icon{margin-left:6rpx;font-size:35rpx}.pause-icon{display:flex;gap:9rpx}.pause-icon text{width:9rpx;height:34rpx;border-radius:5rpx;background:#fff}
.theme-male.soundboard-page{background:linear-gradient(180deg,#f7fbff 0%,#eff7fb 100%)}.theme-male .theme-option.active{background:#e4f1f8}.theme-male .ring-link{background:#dff3fd}.theme-male .toy-shell{border-color:#68afd5;background:linear-gradient(160deg,#bcecff 0%,#78c8ec 56%,#56afd6 100%);box-shadow:0 22rpx 38rpx #357da02e,inset 0 9rpx 9rpx #fff8,inset 0 -10rpx 13rpx #247da53b}.theme-male .sound-key{background:linear-gradient(150deg,#e7f9ff,#99d9f1)}.theme-male .sound-key.active{background:linear-gradient(150deg,#fff,#b7e9fa)}.theme-male .hero-title{color:#3184b2}.theme-male .hero-small{color:#386f8e}.theme-male .hero-badge{color:#397897}.theme-male .album-hole{border-color:#6da8ca}.theme-male .main-control{background:#6da8ca;box-shadow:0 9rpx 20rpx #397d9d52}
@keyframes spin{to{transform:rotate(360deg)}}
@media screen and (max-width:340px){.soundboard-page{padding-left:20rpx;padding-right:20rpx}.toy-wrap{padding-left:42rpx}.keyring{left:-8rpx}.ring-large{width:100rpx;height:100rpx}.toy-shell{min-height:370rpx;padding-left:22rpx;padding-right:22rpx}.button-row{padding-left:28rpx;padding-right:28rpx}.sound-key{flex-basis:62rpx;width:62rpx;height:45rpx}.hero-stage{height:168rpx}.hero-image{width:122rpx;height:156rpx}.hero-copy{width:220rpx}.hero-title{font-size:36rpx}.player-controls{gap:45rpx}}
