page{min-height:100%;background:#fff7f8;color:#493c40}.question-page{min-height:100vh;padding:0 28rpx 150rpx;box-sizing:border-box}.filter-row{width:calc(100% + 20rpx);margin:0 -10rpx 14rpx;white-space:nowrap}.filter-chip{display:inline-flex;align-items:center;height:52rpx;margin:6rpx;padding:0 22rpx;border-radius:30rpx;background:#fff0f1;color:#ae7f87;font-size:21rpx}.filter-chip.active{background:#c97982;color:#fff}.question-summary{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-bottom:16rpx;padding:22rpx;background:#fff;border-radius:22rpx;box-shadow:0 8rpx 24rpx #bd788012}.summary-title,.summary-desc{display:block}.summary-title{font-size:26rpx;font-weight:600}.summary-desc{margin-top:7rpx;color:#ad989c;font-size:19rpx}.summary-count{flex:none;color:#b49da2;font-size:19rpx}.summary-count text{color:#c27480;font-size:30rpx;font-weight:600}.loading{padding:160rpx 0}.question-card{margin-bottom:16rpx;padding:24rpx 22rpx;background:#fff;border:1rpx solid #f5e5e7;border-radius:23rpx;box-shadow:0 8rpx 24rpx #bd788012}.card-top,.people,.card-meta{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.status{padding:5rpx 13rpx;border-radius:16rpx;background:#fff0f1;color:#c27480;font-size:18rpx}.status-answered{background:#eaf5f0;color:#669780}.status-closed{background:#f1eeee;color:#98898c}.time{color:#b6a3a6;font-size:18rpx}.question-title{display:block;margin-top:16rpx;font-size:29rpx;font-weight:600;line-height:1.45}.question-body{display:-webkit-box;margin-top:8rpx;overflow:hidden;color:#958186;font-size:21rpx;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:2}.cover{width:100%;height:250rpx;margin-top:16rpx;border-radius:17rpx;background:#fff3f4}.people{margin-top:17rpx;color:#a0878c;font-size:20rpx}.rating{color:#c27480;font-weight:600}.card-meta{justify-content:flex-start;margin-top:15rpx;padding-top:14rpx;border-top:1rpx solid #f6eaeb;color:#b39ca0;font-size:18rpx}.card-meta text{display:flex;align-items:center;gap:5rpx}.card-meta text:last-child{margin-left:auto}.floating-add{position:fixed;right:max(28rpx,calc((100vw - 750rpx)/2 + 28rpx));bottom:calc(42rpx + env(safe-area-inset-bottom));z-index:10;display:flex;align-items:center;justify-content:center;width:94rpx;height:94rpx;border-radius:50%;background:#c97982;box-shadow:0 12rpx 26rpx #c9798250}.load-more{padding:20rpx;text-align:center;color:#b49da2;font-size:20rpx}.editor-sheet{height:80vh;padding:64rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));box-sizing:border-box}.sheet-title{display:block;font-size:34rpx;font-weight:600}.sheet-help{display:block;margin-top:8rpx;color:#ad989c;font-size:20rpx}.editor-scroll{height:calc(80vh - 220rpx);margin:22rpx 0}.title-input,.body-input{display:block;width:100%;box-sizing:border-box;background:#fff8f8;border:1rpx solid #f3e3e5;border-radius:16rpx;color:#56464a;font-size:24rpx}.title-input{height:82rpx;padding:0 20rpx}.body-input{min-height:210rpx;margin-top:16rpx;padding:20rpx;line-height:1.6}.upload-block{margin-top:22rpx}.field-label{display:block;margin-bottom:14rpx;color:#806d72;font-size:22rpx}.uploading{display:block;margin-top:8rpx;color:#c27480;font-size:19rpx}@media screen and (max-width:340px){.question-page{padding-left:20rpx;padding-right:20rpx}.summary-desc{font-size:17rpx}.question-card{padding-left:18rpx;padding-right:18rpx}}
