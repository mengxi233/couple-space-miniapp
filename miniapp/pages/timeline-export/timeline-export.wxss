page{background:#fff7f8;color:#493c40}.export-page{padding:calc(100px + env(safe-area-inset-top)) 36rpx calc(50rpx + env(safe-area-inset-bottom))}.back{font-size:25rpx;color:#b8757e;margin-bottom:28rpx}.eyebrow{display:block;font-size:19rpx;letter-spacing:4rpx;color:#bb9693}.title{display:block;font-size:46rpx;font-weight:600;margin:16rpx 0}.hint{display:block;font-size:24rpx;color:#9c8489;line-height:1.7;margin:22rpx 0}.error{display:block;color:#b85c70;margin:24rpx 0;line-height:1.7}.poster{width:100%;display:block;border-radius:16rpx;margin-bottom:28rpx}van-button{display:block;margin-top:20rpx}.hidden-canvas{position:fixed;left:-800px;top:0;width:750px;height:1000px;pointer-events:none}
