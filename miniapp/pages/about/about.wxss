page{background:#fff;color:#493c40}
.about-page{min-height:100vh;box-sizing:border-box;display:flex;flex-direction:column;padding:80rpx 40rpx calc(32rpx + env(safe-area-inset-bottom))}
.app-identity{text-align:center;padding:24rpx 12rpx 66rpx}
.app-icon{display:block;width:190rpx;height:190rpx;margin:0 auto 32rpx;border-radius:42rpx;background:#fff7f8;box-shadow:0 12rpx 32rpx #b8737f14}
.app-name{display:block;font-size:42rpx;font-weight:600;line-height:1.4}
.app-version{display:block;margin-top:12rpx;font-size:30rpx;color:#69575d}
.app-description{display:block;margin-top:26rpx;font-size:24rpx;color:#947d83;line-height:1.7}
.about-menu{border-top:1rpx solid #f0e8ea;border-bottom:1rpx solid #f0e8ea}
.about-row{display:flex;align-items:center;gap:24rpx;width:100%;min-height:112rpx;padding:28rpx 12rpx;background:#fff;text-align:left;line-height:1.5;box-sizing:border-box}
.about-row-pressed{background:#fff7f8}
.row-label{flex:1;min-width:0;font-size:30rpx;font-weight:400;color:#493c40;white-space:nowrap}
.row-trailing{display:flex;align-items:center;gap:14rpx;max-width:50%;min-width:0;margin-left:auto}
.row-detail{min-width:0;font-size:24rpx;font-weight:400;color:#a28c93;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.row-arrow{display:flex;flex-shrink:0;align-items:center}
.version-summary{display:flex;flex-direction:column;gap:8rpx;padding:28rpx 8rpx 40rpx;color:#987c84;font-size:23rpx;line-height:1.8;text-align:center}.summary-label{color:#c27480;font-size:22rpx;font-weight:600}.summary-text{display:block}
.about-footer{margin-top:auto;padding-top:44rpx}
