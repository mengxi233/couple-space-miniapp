page{background:#fff7f8}.notifications-page{min-height:100vh;padding:55rpx 32rpx 60rpx;box-sizing:border-box;color:#493c40}.page-head{display:flex;align-items:center;gap:22rpx;padding:8rpx 4rpx 35rpx}.head-copy{flex:1}.eyebrow{display:block;color:#c1848c;letter-spacing:4rpx;font-size:18rpx}.title{display:block;margin-top:8rpx;font-size:45rpx;font-weight:600}.loading{padding:130rpx 0}.notice-card{display:flex;align-items:flex-start;gap:18rpx;padding:25rpx 22rpx;margin:16rpx 0;background:#fff;border-radius:23rpx;box-shadow:0 8rpx 25rpx #b8737f12}.notice-card.read{opacity:.72}.notice-icon{display:flex;align-items:center;justify-content:center;flex:none;width:58rpx;height:58rpx;border-radius:50%;background:#fde8e9}.notice-copy{flex:1;min-width:0}.notice-title-row{display:flex;align-items:center;gap:10rpx}.notice-title{color:#5b4548;font-size:27rpx;font-weight:600}.notice-content{display:block;margin-top:9rpx;color:#806d72;font-size:23rpx;line-height:1.5;word-break:break-all}.notice-time{display:block;margin-top:10rpx;color:#baa4a8;font-size:19rpx}
.notifications-page{padding-left:36rpx;padding-right:36rpx}.page-head{padding-left:8rpx;padding-right:8rpx}
