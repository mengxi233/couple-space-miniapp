/* Keep the popup close icon in its own top-right zone, away from title actions. */
.detail-sheet,.editor-sheet{padding-top:64rpx}
.sheet-title-row{min-height:48rpx;padding-right:72rpx;box-sizing:border-box}
.sheet-title{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sheet-actions{flex:none}
.actions-sheet{padding-top:64rpx}
.todo-photo-section{margin-top:24rpx}
.todo-photo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx}
.todo-photo{width:100%;height:180rpx;border-radius:14rpx;background:#fff5f5}
.form-hint{display:block;margin-top:10rpx;color:#b49da2;font-size:19rpx;line-height:1.5}
.uploading-hint{color:#c27480}
.todo-photos-editor{padding-bottom:8rpx}
.todo-share-button{display:flex;align-items:center;justify-content:center;gap:10rpx;width:100%;height:76rpx;margin-top:18rpx;padding:0;border:1rpx solid #efd7da;border-radius:40rpx;background:#fff8f8;color:#c27480;font-size:24rpx;line-height:1;white-space:nowrap}
.todo-share-button::after{border:0}
