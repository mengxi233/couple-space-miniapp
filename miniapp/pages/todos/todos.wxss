er;justify-content:space-between;gap:20rpx;margin-bottom:22rpx}.sheet-title{font-size:35rpx;font-weight:600;line-height:1.4}.sheet-actions{display:flex;gap:28rpx}.detail-badges{display:flex;gap:12rpx;flex-wrap:wrap;margin-bottom:18rpx}.detail-badge{padding:7rpx 14rpx;border-radius:16rpx;background:#fff0f1;color:#b17f86;font-size:20rpx}.detail-badge.done{background:#e5f4ee;color:#57927b}.detail-scroll{max-height:54vh;min-height:160rpx;padding-bottom:22rpx}.markdown-view{display:block;color:#604e53;font-size:25rpx;line-height:1.7;word-break:break-word}.detail-empty{display:block;color:#b49da2;padding:30rpx 0}.location-card{display:flex;gap:14rpx;margin-top:24rpx;padding:18rpx;background:#fff7f5;border-radius:16rpx;color:#806e72}.location-card text{display:block;font-size:22rpx;line-height:1.5}.location-card text+text{color:#ad979b}.detail-editor-line{margin-top:26rpx;color:#b19c9f;font-size:19rpx}.preview-toggle{color:#c27480;font-size:23rpx}.editor-scroll{max-height:67vh;margin:0 -10rpx;padding:0 10rpx}.markdown-editor{margin:14rpx 0 22rpx;border:1rpx solid #f1dfe1;border-radius:16rpx;overflow:hidden}.markdown-tools{white-space:nowrap;border-bottom:1rpx solid #f1dfe1;background:#fffafa}.markdown-tools text{display:inline-block;padding:18rpx 18rpx;color:#b8757e;font-size:21rpx}.markdown-input{display:block;width:100%;min-height:220rpx;padding:20rpx;box-sizing:border-box;color:#59484c;font-size:24rpx;line-height:1.7}.editor-preview{min-height:220rpx;margin:14rpx 0 22rpx;padding:20rpx;border:1rpx solid #f1dfe1;border-radius:16rpx;background:#fff}.form-section{padding:16rpx 0}.section-label{display:block;margin-bottom:13rpx;color:#806e72;font-size:23rpx}.choice-row{display:flex;gap:14rpx}.choice{padding:12rpx 22rpx;border:1rpx solid #f0dfe1;border-radius:20rpx;color:#b17f86;font-size:21rpx}.choice.selected{border-color:#c97982;background:#c97982;color:#fff}.choice.important{color:#b47a30}.choice.urgent{color:#c25b69}.date-row{display:flex;gap:24rpx}.date-row>view{flex:1}