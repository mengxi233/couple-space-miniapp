page{height:100%;overflow:hidden;background:#000}.screen{position:fixed;top:0;right:0;bottom:0;left:0;padding:0;margin:0}.canvas{display:block;width:100%;height:100%}.controls{position:absolute;left:calc(12px + env(safe-area-inset-left));top:12px;display:flex;gap:8px}.controls .icon-button{display:flex;align-items:center;justify-content:center;flex:none;width:40px;min-width:40px;height:40px;margin:0;padding:0;line-height:1;font-size:16px;border-radius:50%;background:#3338;color:#fff;border:0;box-sizing:border-box}.icon-button:after{border:0}.icon-button[disabled]{opacity:.5}.play-icon{width:0;height:0;border-top:9px solid transparent;border-bottom:9px solid transparent;border-left:14px solid #fff;margin-left:3px}.pause-icon{display:flex;gap:5px}.pause-icon view{width:4px;height:18px;background:#fff;border-radius:1px}.save-icon{width:20px;height:22px;position:relative}.save-arrow{position:absolute;left:9px;top:1px;width:2px;height:13px;background:#fff}.save-arrow:after{content:'';position:absolute;left:-4px;bottom:0;width:8px;height:8px;border-right:2px solid #fff;border-bottom:2px solid #fff;transform:rotate(45deg)}.save-tray{position:absolute;bottom:0;left:1px;right:1px;height:5px;border:2px solid #fff;border-top:0;border-radius:0 0 2px 2px}.error{position:absolute;bottom:calc(20px + env(safe-area-inset-bottom));left:15%;right:15%;color:#fff;background:#333c;padding:12px;font-size:14px;text-align:center}
