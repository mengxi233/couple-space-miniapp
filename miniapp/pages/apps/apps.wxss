page{background:#fff7f8;color:#493c40}.apps-page{padding:0 32rpx 180rpx}.app-grid{display:flex;flex-direction:column;gap:14rpx}.app-card{display:flex;align-items:center;gap:20rpx;width:100%;min-height:136rpx;padding:20rpx 22rpx;box-sizing:border-box;background:#fff;border:1rpx solid #f6e6e8;border-radius:23rpx;box-shadow:0 8rpx 24rpx #c9798212}.app-card:active{transform:scale(.992);background:#fffafa}.app-icon{display:flex;align-items:center;justify-content:center;flex:none;width:76rpx;height:76rpx;background:linear-gradient(145deg,#fff2f3,#f9e5e9);border-radius:21rpx}.app-info{display:grid;flex:1;min-width:0;grid-template-columns:auto 1fr;grid-template-rows:auto auto;column-gap:14rpx;align-items:center}.app-name{display:block;grid-column:1;grid-row:1;font-size:28rpx;font-weight:600;white-space:nowrap}.app-tag{display:block;grid-column:2;grid-row:1;min-width:0;color:#c27480;font-size:18rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.app-tag.locked{color:#9e8c91}.app-desc{display:block;grid-column:1/3;grid-row:2;margin-top:7rpx;overflow:hidden;color:#a99095;font-size:20rpx;line-height:1.45;white-space:nowrap;text-overflow:ellipsis}.app-arrow{flex:none}@media screen and (max-width:340px){.apps-page{padding-left:22rpx;padding-right:22rpx}.app-card{min-height:126rpx;padding:17rpx 18rpx;gap:16rpx}.app-icon{width:68rpx;height:68rpx}.app-name{font-size:26rpx}.app-desc{font-size:18rpx}.app-tag{font-size:16rpx}}
