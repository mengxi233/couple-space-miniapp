<view class="profile-page">
  <view class="profile-head">
    <view class="avatar-wrap" bindtap="openAvatarPicker">
      <progressive-image class="profile-avatar" src="{{avatarUrl || '/assets/previews/avatar-yu.jpg'}}" mode="aspectFill" />
      <view class="avatar-edit"><van-icon name="edit" size="14px" color="#fff" /></view>
    </view>
    <view class="profile-info"><text class="profile-name">{{user.nickname || '访客'}}</text><text class="profile-role">{{roleText}}</text></view>
  </view>

  <view wx:if="{{!loggedIn}}" class="card login-card"><view><text class="card-title">还没有登录</text><text class="card-help">登录后可以绑定情侣身份并记录生活</text></view><van-button type="primary" size="small" bindtap="goLogin">微信登录</van-button></view>

  <view class="card settings-card">
    <view class="setting-row" wx:if="{{loggedIn}}" bindtap="openAvatarPicker"><van-icon name="user-o" color="#d07f89" size="21px"/><text>个人资料</text><text class="setting-value">头像与名称</text><van-icon name="arrow" color="#cbb0b2" size="16px"/></view>
    <view class="setting-row"><van-icon name="friends-o" color="#d07f89" size="21px"/><text>情侣空间</text><text class="setting-value">{{user.coupleId ? '已绑定' : '未绑定'}}</text></view>
    <view class="setting-row" wx:if="{{!user.coupleId}}" bindtap="openActivation"><van-icon name="invitation" color="#d07f89" size="21px"/><text>激活情侣身份</text><text class="setting-value accent">{{loggedIn ? '输入激活码' : '登录后激活'}}</text><van-icon name="arrow" color="#cbb0b2" size="16px"/></view>
    <view class="setting-row" wx:if="{{canEditCouple}}" bindtap="openLoveDate"><van-icon name="clock-o" color="#d07f89" size="21px"/><text>相恋日期</text><text class="setting-value">{{loveStartDate}}</text><van-icon name="arrow" color="#cbb0b2" size="16px"/></view>
    <view class="setting-row"><van-icon name="lock" color="#d07f89" size="21px"/><text>访客权限</text><text class="setting-value">只读</text></view>
    <view class="setting-row" wx:if="{{loggedIn}}" bindtap="openNotifications"><van-icon name="bell" color="#d07f89" size="21px"/><text>通知</text><text class="setting-value accent">{{unreadCount ? unreadCount + ' 条未读' : '暂无未读'}}</text><van-icon name="arrow" color="#cbb0b2" size="16px"/></view>
    <view class="setting-row" bindtap="openNotificationSettings"><van-icon name="setting-o" color="#d07f89" size="21px"/><text>通知设置</text><text class="setting-value">{{emailEnabled ? '邮件已开启' : '站内通知'}}</text><van-icon name="arrow" color="#cbb0b2" size="16px"/></view>
    <view class="setting-row" wx:if="{{canManageBanners}}" bindtap="openBannerManager"><van-icon name="photo-o" color="#d07f89" size="21px"/><text>首页轮播图</text><text class="setting-value accent">管理图片与顺序</text><van-icon name="arrow" color="#cbb0b2" size="16px"/></view>
    <view class="setting-row" wx:if="{{canManageRooms}}" bindtap="openRoomManager"><van-icon name="apps-o" color="#d07f89" size="21px"/><text>灯牌房间管理</text><text class="setting-value">全部房间与资源</text><van-icon name="arrow" color="#cbb0b2" size="16px"/></view>
    <view class="setting-row" bindtap="openAbout"><van-icon name="info-o" color="#d07f89" size="21px"/><text>关于</text><text class="setting-value">v{{currentVersion}}</text><van-icon name="arrow" color="#cbb0b2" size="16px"/></view>
    <view class="setting-row logout-row" wx:if="{{loggedIn}}" bindtap="logout"><van-icon name="close" color="#c27480" size="21px"/><text>退出登录</text><text class="setting-value">切换账号</text></view>
  </view>

  <view wx:if="{{showAvatarPicker}}" class="avatar-picker card"><text class="picker-title">选择头像</text><view class="avatar-options"><view wx:for="{{avatarOptions}}" wx:key="id" class="avatar-option {{item.url === avatarUrl ? 'selected' : ''}}" data-url="{{item.url}}" bindtap="selectAvatar"><image src="{{item.url}}" mode="aspectFill"/><text>{{item.name}}</text></view></view><van-button size="small" plain color="#c97982" round bindtap="closeAvatarPicker">取消</van-button></view>

  <van-popup show="{{showNotificationSettings}}" round position="bottom" closeable bind:close="closeNotificationSettings"><view class="settings-sheet"><text class="sheet-title">通知设置</text><text class="sheet-help">站内通知会记录在这里；邮件通知需要填写邮箱。</text><view class="switch-row"><view><text>站内通知</text><text class="switch-help">任务和订单动态</text></view><switch checked="{{notificationSettings.inAppEnabled}}" color="#c97982" bindchange="toggleInApp"/></view><view class="switch-row"><view><text>邮件通知</text><text class="switch-help">后端配置 SMTP 后发送</text></view><switch checked="{{notificationSettings.emailEnabled}}" color="#c97982" bindchange="toggleEmail"/></view><input class="email-input" value="{{notificationSettings.email}}" placeholder="邮箱地址" bindinput="onEmailInput"/><van-button type="primary" block loading="{{savingSettings}}" bindtap="saveNotificationSettings">保存设置</van-button></view></van-popup>

  <van-popup show="{{showLoveDatePicker}}" round position="bottom" closeable bind:close="closeLoveDate"><view class="settings-sheet love-date-sheet"><text class="sheet-title">修改相恋日期</text><text class="sheet-help">每一天都从这个日期开始计算。</text><picker mode="date" value="{{loveStartDate}}" start="2000-01-01" end="2100-12-31" bindchange="onLoveDateChange"><view class="date-picker-row"><text>{{loveStartDate}}</text><van-icon name="arrow" size="16px" color="#cbb0b2"/></view></picker><van-button type="primary" block loading="{{savingLoveDate}}" bindtap="closeLoveDate">完成</van-button></view></van-popup>
  <van-popup show="{{showActivationSheet}}" round position="bottom" closeable bind:close="closeActivation"><view class="settings-sheet activation-sheet"><text class="sheet-title">激活情侣身份</text><text class="sheet-help">请输入 16 位激活码，激活后即可加入情侣空间。</text><van-field value="{{activationCode}}" maxlength="16" center clearable placeholder="请输入激活码" bind:change="onActivationInput"/><van-button type="primary" block loading="{{activating}}" bindtap="submitActivation">确认激活</van-button></view></van-popup>
  <van-popup show="{{showBannerManager}}" round position="bottom" closeable bind:close="closeBannerManager"><view class="settings-sheet banner-sheet"><text class="sheet-title">首页轮播图</text><text class="sheet-help">最多上传 {{bannerMaxCount}} 张。启用需要展示的图片，并用箭头调整首页播放顺序。</text><view class="banner-count-row"><view><text>首页展示数量</text><text class="switch-help">当前启用图片中取前 {{bannerDisplayCount}} 张</text></view><van-stepper value="{{bannerDisplayCount}}" min="1" max="{{bannerMaxDisplayCount}}" integer bind:change="changeBannerDisplayCount"/></view><scroll-view class="banner-list" scroll-y><view wx:for="{{banners}}" wx:key="id" class="banner-manage-row"><image src="{{item.url}}" mode="aspectFill"/><view class="banner-row-main"><text>第 {{index + 1}} 张</text><switch checked="{{item.isActive}}" color="#c97982" data-index="{{index}}" bindchange="toggleBanner"/></view><view class="banner-row-actions"><van-icon name="arrow-up" size="19px" color="{{index ? '#b8757e' : '#d8c9cb'}}" data-index="{{index}}" data-direction="-1" bindtap="moveBanner"/><van-icon name="arrow-down" size="19px" color="{{index < banners.length - 1 ? '#b8757e' : '#d8c9cb'}}" data-index="{{index}}" data-direction="1" bindtap="moveBanner"/><van-icon name="delete-o" size="20px" color="#c27480" data-index="{{index}}" bindtap="deleteBanner"/></view></view><view wx:if="{{!banners.length}}" class="banner-empty">还没有服务器轮播图，请先上传</view></scroll-view><view class="banner-upload"><van-uploader file-list="{{bannerImageList}}" max-count="1" preview-size="82px" upload-icon="photograph" disabled="{{bannerUploading || banners.length >= bannerMaxCount}}" bind:after-read="uploadBannerImage"/><text>上传新轮播图</text></view><van-button type="primary" block loading="{{savingBanners}}" disabled="{{bannerUploading}}" bindtap="saveBannerSettings">保存轮播设置</van-button></view></van-popup>
  <app-tabbar current="4" />
</view>
