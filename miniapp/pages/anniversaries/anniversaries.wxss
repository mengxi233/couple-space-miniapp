page{background:#fff7f8;color:#493c40}.anniversary-page{padding:0 30rpx calc(40rpx + env(safe-area-inset-bottom))}.card{padding:28rpx;margin:24rpx 0;background:#fff;border-radius:26rpx}.title{display:block;font-size:30rpx;font-weight:600;overflow-wrap:anywhere}.hint{display:block;font-size:23rpx;line-height:1.7;color:#a38b91;margin-top:10rpx;overflow-wrap:anywhere}.toolbar,.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:25rpx}.toolbar{margin-top:24rpx;color:#a38b91}.row{padding:26rpx 0;border-bottom:1rpx solid #f5e8e7}.occasion{display:flex;gap:20rpx;align-items:center}.occasion-copy{flex:1;min-width:0}.count{flex:none;min-width:100rpx;text-align:center;color:#c97982;font-size:42rpx;font-weight:600}.actions{display:flex;justify-content:flex-end;align-items:center;flex-wrap:wrap;gap:18rpx;margin-top:26rpx}.input{box-sizing:border-box;background:#fff7f8;border-radius:14rpx;padding:20rpx;font-size:26rpx;margin-top:16rpx;height:80rpx;width:100%}.label{display:block;color:#806a70;font-size:25rpx;margin-top:24rpx}.date-row{display:flex;gap:20rpx}.date-row picker{flex:1;min-width:0}.choices{display:flex;flex-wrap:wrap;gap:20rpx;margin:20rpx 0;font-size:25rpx}.choices label{display:flex;align-items:center;min-width:42%}.warning{color:#b87551}.delivery{border-top:1rpx solid #f5e8e7;margin-top:24rpx;padding-top:18rpx;font-size:24rpx}.policy{padding:0 10rpx}
.occasion{display:block}.occasion-top{display:flex;gap:20rpx;align-items:center}.elapsed{margin-top:20rpx;padding-top:12rpx;border-top:1rpx solid #f5e8e7}.elapsed-value{display:block;color:#b8757e;font-size:28rpx;line-height:1.8;font-variant-numeric:tabular-nums;font-family:monospace;overflow-wrap:anywhere}
