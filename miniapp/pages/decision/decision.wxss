page{background:#fff7f8;color:#493c40}.tool-page{padding:100px 32rpx 50rpx}.back,.link{color:#b8757e;font-size:25rpx}.eyebrow{display:block;margin-top:28rpx;font-size:20rpx;letter-spacing:4rpx;color:#bb9693}.title{display:block;font-size:48rpx;margin-top:12rpx;font-weight:600}.hint{display:block;font-size:23rpx;color:#a18d93;line-height:1.7;margin:20rpx 0}.wheel-wrap{position:relative;width:300px;height:300px;margin:25px auto 12px;max-width:100%}.wheel{width:100%;height:100%}.pointer{position:absolute;top:-4px;left:calc(50% - 12px);border-left:12px solid transparent;border-right:12px solid transparent;border-top:27px solid #904b58;z-index:2}.result{text-align:center;font-size:34rpx;font-weight:600;min-height:70rpx;overflow-wrap:anywhere}.card{background:#fff;border-radius:24rpx;padding:26rpx;margin-top:26rpx}.label{font-size:28rpx;font-weight:500}.presets{display:flex;gap:18rpx;margin:22rpx 0;flex-wrap:wrap}.presets text{background:#fff0f2;color:#b8757e;padding:12rpx 18rpx;border-radius:30rpx;font-size:23rpx}textarea{width:100%;height:230rpx;background:#fff8f9;font-size:27rpx;padding:18rpx;box-sizing:border-box;border-radius:14rpx}.switch-row{display:flex;align-items:center;justify-content:space-between}.history{display:flex;gap:20rpx;justify-content:space-between;border-top:1rpx solid #f5eeee;padding:20rpx 0;font-size:24rpx}.history text:last-child{font-size:20rpx;color:#b49b9f;flex-shrink:0}
