page{background:#fff7f8}.cart-page{min-height:100vh;padding:55rpx 32rpx 55rpx;box-sizing:border-box;color:#493c40}.page-head{display:flex;align-items:center;justify-content:space-between;padding:8rpx 4rpx 35rpx}.page-head>view:nth-child(2){flex:1;margin-left:22rpx}.head-spacer{width:25rpx}.eyebrow{display:block;color:#c1848c;letter-spacing:4rpx;font-size:18rpx}.title{display:block;margin-top:8rpx;font-size:45rpx;font-weight:600}.loading{padding:120rpx 0}.need-login{display:flex;flex-direction:column;align-items:center;text-align:center;padding:170rpx 35rpx 80rpx}.need-title{margin-top:25rpx;font-size:32rpx;font-weight:600;color:#604c50}.need-desc{margin-top:14rpx;color:#b39da1;font-size:23rpx;line-height:1.6}.login-button{margin-top:30rpx!important;background:#d07f89!important;border-color:#d07f89!important}.cart-item{display:flex;align-items:center;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #f3e2e4;background:#fff}.cart-image,.cart-placeholder{flex:none;width:145rpx;height:145rpx;border-radius:20rpx}.cart-placeholder{display:flex;align-items:center;justify-content:center;background:#f9e8eb}.cart-main{flex:1;min-width:0}.cart-name{display:block;font-size:28rpx;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.cart-desc{display:block;margin-top:8rpx;color:#b19ca0;font-size:20rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.cart-price{display:block;margin-top:20rpx;color:#c27480;font-size:23rpx;font-weight:600}.cart-control{display:flex;flex-direction:column;align-items:flex-end;gap:22rpx}.cart-summary{display:flex;justify-content:space-between;margin:30rpx 4rpx 22rpx;font-size:26rpx;color:#786265}.summary-points{color:#c27480;font-weight:600}.checkout-button{background:#d07f89!important;border-color:#d07f89!important;border-radius:45rpx!important}.note-editor{padding:40rpx 30rpx 45rpx;box-sizing:border-box}.note-title{display:block;margin-bottom:20rpx;font-size:34rpx;font-weight:600}.confirm-order{margin-top:25rpx!important;background:#d07f89!important;border-color:#d07f89!important}
