page{background:#fff7f8;color:#493c40;--button-primary-background-color:#c97982;--button-primary-border-color:#c97982}.timeline-page{padding:calc(100px + env(safe-area-inset-top)) 36rpx 60rpx}.back{font-size:25rpx;color:#b8757e;margin-bottom:28rpx}.eyebrow{display:block;font-size:19rpx;letter-spacing:4rpx;color:#bb9693}.page-title{display:block;font-size:48rpx;font-weight:600;margin:14rpx 0}.subtitle{display:block;font-size:23rpx;color:#b49b9f;line-height:1.6}.toolbar{display:flex;justify-content:space-between;align-items:center;margin-top:32rpx;font-size:24rpx;color:#b8757e}.timeline{margin:25rpx 0 0 12rpx}.node{position:relative;border-left:2rpx solid #ecd5d9;padding:0 0 32rpx 32rpx}.node:last-child{border-color:transparent}.dot{position:absolute;width:16rpx;height:16rpx;background:#fff7f8;border:4rpx solid #c97982;border-radius:50%;left:-13rpx;top:4rpx}.date{display:block;font-size:24rpx;font-weight:500;color:#b8757e;margin-bottom:16rpx}.event-card{background:#fff;padding:26rpx;border-radius:24rpx;box-shadow:0 10rpx 28rpx #b8737f0d}.event-title{display:block;font-size:30rpx;font-weight:600;overflow-wrap:anywhere}.description{display:block;font-size:24rpx;color:#9c8489;line-height:1.7;margin-top:12rpx;white-space:pre-wrap;overflow-wrap:anywhere}.cover{display:block;width:100%;height:260rpx;border-radius:16rpx;margin-top:20rpx;background:#f9eeee}.card-foot{display:flex;justify-content:space-between;align-items:center;color:#b99da1;font-size:20rpx;margin-top:22rpx}.state{padding:40rpx 0;display:flex;gap:22rpx;flex-direction:column;align-items:center;color:#ac9296;font-size:24rpx}.loading{display:block;text-align:center;padding:30rpx;color:#ac9296;font-size:24rpx}
