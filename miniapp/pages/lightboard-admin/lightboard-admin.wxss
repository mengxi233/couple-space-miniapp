page{background:#fff7f8;color:#514244}.page{padding:28rpx 28rpx 60rpx}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx}.title{font-size:32rpx;font-weight:600;display:block;margin-bottom:18rpx}.hint{display:block;font-size:24rpx;color:#9a858b;line-height:1.65;margin:14rpx 0}.metrics{display:flex;flex-wrap:wrap;gap:22rpx}.metric{flex:1;min-width:26%;font-size:24rpx;color:#9a858b}.metric text{display:block;font-size:40rpx;font-weight:600;color:#bd7480;margin-bottom:6rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:14rpx 0;font-size:25rpx}.code{font-family:monospace;font-size:23rpx;word-break:break-all;color:#b8757e}.content{display:block;line-height:1.6;font-size:28rpx;margin:20rpx 0;word-break:break-all}.actions{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:24rpx}.actions van-button{display:block;flex:1;min-width:42%}.error{color:#b13b56}.empty{text-align:center;padding:50rpx 20rpx;color:#a18d93}.pagination{display:flex;align-items:center;justify-content:space-between;font-size:24rpx}
.pagination{gap:16rpx;padding:12rpx 0;flex-wrap:nowrap}.pagination-button{display:block;flex:0 0 auto;width:auto}.pagination-count{flex:1;min-width:0;text-align:center;white-space:nowrap;color:#9a858b}
