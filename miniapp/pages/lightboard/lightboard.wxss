page{background:#fff7f8;color:#493c40}.tool-page{padding:100px 32rpx 50rpx}.back{color:#b8757e;font-size:25rpx}.eyebrow{display:block;margin-top:28rpx;font-size:20rpx;letter-spacing:4rpx;color:#bb9693}.title{display:block;font-size:48rpx;margin:12rpx 0 28rpx;font-weight:600}.preview{height:200rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;padding:20rpx;overflow:hidden;font-size:42rpx;font-weight:bold}.preview text{white-space:nowrap}.hint{display:block;font-size:23rpx;color:#a18d93;line-height:1.7;margin:20rpx 0}.card{background:#fff;padding:26rpx;border-radius:24rpx;margin:24rpx 0}.label{display:block;font-size:27rpx;margin:16rpx 0}.row{display:flex;justify-content:space-between;align-items:center;min-height:88rpx;font-size:27rpx;gap:20rpx}.value{color:#b8757e}input{background:#fff7f8;border-radius:14rpx;height:80rpx;padding:0 20rpx;font-size:27rpx}.themes{display:flex;flex-wrap:wrap;gap:18rpx}.themes view{padding:18rpx;border-radius:12rpx;font-size:23rpx;border:1rpx solid #eadce0}.colors{display:flex;gap:16rpx;flex-wrap:wrap;margin:20rpx 0}.swatch{width:48rpx;height:48rpx;border-radius:50%;border:2rpx solid #dfd2d7}.selected{outline:4rpx solid #c97982;outline-offset:3rpx}
