<view class="page">
 <view class="card"><text class="title">多人灯牌 · 最多 6 人</text><text class="hint">免登录使用。同步播放：每台显示同一句话，滚动周期一致。拼接延长：按屏幕顺序组成一条长灯牌。房间 4 小时后失效。</text><text class="hint">访客身份保存在本机，清除小程序数据后无法恢复原来的房主权限。</text>
 <view wx:if="{{!room}}" class="actions"><van-button type="primary" round disabled="{{busy}}" bindtap="createRoom">创建房间</van-button><view class="row"><input placeholder="粘贴房间码" value="{{roomCode}}" bindinput="codeInput"/></view><van-button plain type="primary" round disabled="{{busy}}" bindtap="joinRoom">加入房间</van-button></view>
 <block wx:else><text selectable="true" class="hint">房间码：{{room.id}}</text><text class="mode">{{room.mode === 'sync' ? '同步播放' : '拼接延长'}} · {{room.members.length}} / 6 人</text><button open-type="share">邀请好友</button></block>
 </view>
 <view wx:if="{{!room || isOwner}}" class="card"><text class="title">公共参数</text><picker range="{{modes}}" value="{{modeIndex}}" bindchange="modeChange"><view class="row">模式 <text class="mode">{{modes[modeIndex]}} ›</text></view></picker><textarea maxlength="80" value="{{form.text}}" bindinput="textChange" placeholder="最多80个字"/>
 <picker range="{{fonts}}" range-key="name" value="{{form.font}}" data-key="font" bindchange="change"><view class="row">字体 <text>{{fonts[form.font].name}} ›</text></view></picker>
 <picker range="{{directions}}" value="{{form.direction}}" data-key="direction" bindchange="change"><view class="row">方向 <text>{{directions[form.direction]}} ›</text></view></picker>
 <text class="hint">字号 {{form.size}}%</text><slider min="25" max="90" value="{{form.size}}" data-key="size" bindchange="change" activeColor="#c97982"/><text class="hint">速度 {{form.speed}}</text><slider min="30" max="240" value="{{form.speed}}" data-key="speed" bindchange="change" activeColor="#c97982"/>
 <view class="row">文字颜色<input value="{{form.fg}}" maxlength="7" data-key="fg" bindinput="colorChange"/></view><view class="row">背景颜色<input value="{{form.bg}}" maxlength="7" data-key="bg" bindinput="colorChange"/></view>
 <van-button wx:if="{{room}}" type="primary" plain block round disabled="{{busy}}" loading="{{busy}}" bindtap="applyConfig">应用参数并生成统一文字图片</van-button><text class="hint">第一版支持纯色背景，文字由房主统一生成，确保各台手机字形一致。修改参数或成员顺序后需要重新准备。</text></view>
 <view wx:if="{{room}}" class="card"><text class="title">从左到右的屏幕顺序</text><view wx:for="{{room.members}}" wx:key="uid" class="row"><text>{{index+1}} · {{item.name}}{{item.uid===uid ? '（我）' : ''}}</text><text>{{item.ready ? '已准备' : '待确认'}}</text><button wx:if="{{isOwner && index>0}}" size="mini" data-index="{{index}}" bindtap="moveUp">前移</button><button wx:if="{{isOwner && item.uid!==uid}}" size="mini" data-uid="{{item.uid}}" bindtap="removeMember" aria-label="移除成员">×</button></view><text class="hint">{{room.config.text}}</text><view class="actions"><van-button type="primary" round block disabled="{{!room.spriteVersion || busy}}" bindtap="enterStage">进入横屏 · 校准并准备</van-button><van-button plain round block bindtap="leave">{{isOwner ? '关闭房间' : '退出房间'}}</van-button></view></view>
 <text wx:if="{{error}}" class="hint error">{{error}}</text><text wx:if="{{busy}}" class="hint">正在处理，请稍候…</text>
</view><canvas type="2d" id="roomSprite" class="sprite"/>
