page{height:100%;overflow:hidden;background:#000}.screen{position:fixed;top:0;right:0;bottom:0;left:0;background:#000}.canvas{display:block}.panel{position:absolute;left:12px;top:12px;width:300px;height:80vh;overflow:auto;background:#fff2f4f2;color:#58454a;border-radius:14px;padding:14px;box-sizing:border-box;font-size:13px}.row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:8px 0}.panel button{display:inline-block;width:auto;margin:4px;padding:0 14px;font-size:13px;line-height:34px;background:#c97982;color:#fff;border-radius:18px}.hint{font-size:12px;line-height:1.5;display:block;margin:8px 0}.error{color:#b13b56}.state{position:absolute;bottom:12px;left:12px;color:#fff;background:#333b;padding:8px;border-radius:8px;font-size:12px;max-width:80%}
